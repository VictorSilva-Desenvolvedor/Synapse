<ui:PixelWindow x:Class="Synapse.Tray.QuickCapture.QuickCaptureWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:Synapse.Tray.UI"
                Title="CAPTURA RAPIDA"
                ShowTitleBar="False"
                Width="700"
                SizeToContent="Height">

    <ui:PixelWindow.Resources>

        <!-- A seta e o unico chrome da janela recolhida: uma faixa de musgo de
             altura total na esquerda. Ela cresce junto com a janela ao expandir. -->
        <Style x:Key="ExpandToggle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <!-- Recolhida a faixa e musgo cheio: ela convida ao clique. Expandida ela
                 escurece, porque o trabalho dela ja foi feito e 28x560px de verde
                 saturado competiriam com o conteudo. Trocado por Background, para o
                 template pintar a partir do estado. -->
            <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource AccentPrimaryEdgeLightBrush}"
                                BorderThickness="0,0,2,0"
                                CornerRadius="0"
                                SnapsToDevicePixels="True">
                            <TextBlock x:Name="Glyph"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{StaticResource VoidBrush}"
                                       FontFamily="{StaticResource FontBody}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       Margin="0,12,0,0"
                                       TextOptions.TextRenderingMode="Aliased"
                                       TextOptions.TextFormattingMode="Display"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentPrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentPrimaryPressedBrush}"/>
                            </Trigger>
                            <!-- FocusVisualStyle e nulo neste estilo, entao o foco de
                                 teclado precisa de indicacao propria: sem isto o controle
                                 fica invisivel para quem navega por Tab. -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter TargetName="Bg" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelHeader" TargetType="TextBlock" BasedOn="{StaticResource PixelHeadline}">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="FieldKey" TargetType="TextBlock" BasedOn="{StaticResource PixelCaption}">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock" BasedOn="{StaticResource PixelTextBase}">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="HintKey" TargetType="TextBlock" BasedOn="{StaticResource PixelTextBase}">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>

    </ui:PixelWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- A SETA -->
        <Button x:Name="ExpandButton"
                Grid.Column="0" Grid.RowSpan="2"
                Content="&#9654;"
                Style="{StaticResource ExpandToggle}"
                Click="OnToggleExpand"
                ToolTip="Expandir para ver o destino (Ctrl+E)"/>

        <!-- ESCRITA — o mesmo TextBox nos dois estados; so a altura muda -->
        <TextBox x:Name="InputBox"
                 Grid.Column="1" Grid.Row="0"
                 MinHeight="46"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto"
                 Padding="12,12,12,12"
                 TextChanged="OnInputChanged"
                 PreviewKeyDown="OnInputKeyDown"/>

        <!-- LINHA DE ATALHOS — visivel apenas recolhida -->
        <Border x:Name="HintStrip"
                Grid.Column="1" Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource EdgeBrush}"
                BorderThickness="0,2,0,0"
                SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" Margin="12,8,12,8">
                <TextBlock Style="{StaticResource HintKey}" Text="ENTER"/>
                <TextBlock Style="{StaticResource HintKey}" Foreground="{StaticResource TextDisabledBrush}" Text=" salvar   "/>
                <TextBlock Style="{StaticResource HintKey}" Text="CTRL+ENTER"/>
                <TextBlock Style="{StaticResource HintKey}" Foreground="{StaticResource TextDisabledBrush}" Text=" com IA   "/>
                <TextBlock Style="{StaticResource HintKey}" Text="SHIFT+ENTER"/>
                <TextBlock Style="{StaticResource HintKey}" Foreground="{StaticResource TextDisabledBrush}" Text=" nova linha"/>
                <TextBlock x:Name="CollapsedStatus"
                           Style="{StaticResource HintKey}"
                           Foreground="{StaticResource SuccessBrush}"
                           HorizontalAlignment="Right"
                           Margin="16,0,0,0"
                           Text="PRONTO"/>
            </StackPanel>
        </Border>

        <!-- BANCADA — visivel apenas expandida -->
        <Border x:Name="PreviewPanel"
                Grid.Column="2" Grid.RowSpan="2"
                Width="300"
                Visibility="Collapsed"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource EdgeBrush}"
                BorderThickness="2,0,0,0"
                SnapsToDevicePixels="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14">

                    <!-- Zona 1: fatos. Sem chamada de rede, sem adivinhacao. -->
                    <TextBlock Style="{StaticResource PanelHeader}"
                               Foreground="{StaticResource AccentPrimaryBrush}"
                               Text="CERTO AGORA"/>

                    <TextBlock Style="{StaticResource FieldKey}" Text="SALVAR SEM IA EM"/>
                    <TextBlock x:Name="RawPathValue" Style="{StaticResource FieldValue}" Text="-"/>

                    <TextBlock Style="{StaticResource FieldKey}" Text="TAGS QUE VOCE DIGITOU"/>
                    <ItemsControl x:Name="TypedTags" Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource AccentPrimaryEdgeDarkBrush}"
                                        BorderThickness="2"
                                        Margin="0,0,6,6"
                                        CornerRadius="0"
                                        SnapsToDevicePixels="True">
                                    <TextBlock Text="{Binding}"
                                               Foreground="{StaticResource AccentPrimaryBrush}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Margin="6,2,6,2"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource FieldKey}" Text="TAMANHO"/>
                    <TextBlock x:Name="SizeValue" Style="{StaticResource FieldValue}" Text="0 palavras"/>

                    <Rectangle Height="2" Fill="{StaticResource EdgeBrush}" Margin="0,4,0,16" SnapsToDevicePixels="True"/>

                    <!-- Zona 2: o que so a IA sabe. Nada aqui e chute. -->
                    <TextBlock Style="{StaticResource PanelHeader}"
                               Foreground="{StaticResource AccentSecondaryBrush}"
                               Text="A IA VAI DECIDIR"/>

                    <TextBlock Style="{StaticResource FieldKey}" Text="TITULO"/>
                    <TextBlock x:Name="AiTitleValue" Style="{StaticResource FieldValue}"
                               Foreground="{StaticResource TextDisabledBrush}" Text="-"/>

                    <TextBlock Style="{StaticResource FieldKey}" Text="PASTA"/>
                    <TextBlock x:Name="AiFolderValue" Style="{StaticResource FieldValue}"
                               Foreground="{StaticResource TextDisabledBrush}" Text="-"/>

                    <TextBlock Style="{StaticResource FieldKey}" Text="CONEXOES SUGERIDAS"/>
                    <ItemsControl x:Name="AiLinks" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Margin="0,0,0,4"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource SuccessBrush}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="AiEmptyHint"
                               Style="{StaticResource FieldValue}"
                               Foreground="{StaticResource TextDisabledBrush}"
                               Text="Titulo, pasta e conexoes sao escolhidos pela IA. Pre-visualize para ver os valores reais antes de gravar."/>

                    <Button x:Name="PreviewButton"
                            Content="PRE-VISUALIZAR"
                            HorizontalAlignment="Stretch"
                            Click="OnPreview"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- RODAPE — visivel apenas expandida -->
        <Border x:Name="FooterStrip"
                Grid.Column="1" Grid.Row="1"
                Visibility="Collapsed"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource EdgeBrush}"
                BorderThickness="0,2,0,0"
                SnapsToDevicePixels="True">
            <Grid Margin="12,10,12,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Style="{StaticResource PixelCaption}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Text="PROVEDOR IA:"/>

                <ComboBox x:Name="ProviderBox"
                          Grid.Row="0" Grid.Column="1"
                          HorizontalAlignment="Left"
                          Width="300"
                          VerticalAlignment="Center"/>

                <!-- Status e botoes numa grade propria: antes dividiam a mesma celula
                     e o botao cobria o texto do status. -->
                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusText"
                               Grid.Column="0"
                               Style="{StaticResource PixelCaption}"
                               Foreground="{StaticResource SuccessBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               TextTrimming="CharacterEllipsis"
                               Text="PRONTO."/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="SaveRawButton"
                                Content="SALVAR SEM IA"
                                MinWidth="160"
                                Margin="0,0,8,0"
                                Click="OnSaveRaw"/>
                        <Button x:Name="ProcessButton"
                                Content="PROCESSAR COM IA"
                                MinWidth="200"
                                Style="{StaticResource PixelButtonPrimary}"
                                Click="OnProcessWithAi"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</ui:PixelWindow>
