<ui:PixelWindow x:Class="Synapse.Tray.Agent.RemoteConfirmationWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:Synapse.Tray.UI"
                Title="AUTORIZACAO REMOTA"
                Width="640"
                SizeToContent="Height"
                Topmost="True"
                ShowInTaskbar="True">

    <ui:PixelWindow.Resources>
        <Style x:Key="FieldKey" TargetType="TextBlock" BasedOn="{StaticResource PixelCaption}">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock" BasedOn="{StaticResource PixelTextBase}">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </ui:PixelWindow.Resources>

    <StackPanel>

        <!-- NIVEL DE RISCO
             Classificado antes de perguntar. Abrir uma nota nao e a mesma coisa que
             digitar no teclado do usuario, e a tela precisa dizer isso — senao o
             vigesimo pedido parece igual ao primeiro. -->
        <Border x:Name="RiskBanner"
                Margin="16,16,16,0"
                Background="{StaticResource SurfaceAltBrush}"
                SnapsToDevicePixels="True">
            <DockPanel>
                <Rectangle x:Name="RiskStripe"
                           DockPanel.Dock="Left"
                           Width="6"
                           Fill="{StaticResource ErrorBrush}"
                           SnapsToDevicePixels="True"/>
                <StackPanel Margin="14,12,12,12">
                    <TextBlock x:Name="RiskLabel"
                               Text="RISCO ALTO"
                               Style="{StaticResource PixelHeadline}"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource ErrorBrush}"/>
                    <TextBlock x:Name="RiskReason"
                               Style="{StaticResource PixelCaption}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- FICHA DO COMANDO -->
        <Grid Margin="16,14,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="QUEM PEDIU" Style="{StaticResource FieldKey}" Margin="0,0,0,8"/>
            <TextBlock x:Name="RequesterText" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="QUANDO" Style="{StaticResource FieldKey}" Margin="0,0,0,8"/>
            <TextBlock x:Name="AgeText" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="O QUE FARA" Style="{StaticResource FieldKey}" Margin="0,0,0,8"/>
            <TextBlock x:Name="ActionText" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}"
                       Foreground="{StaticResource WarningBrush}" Margin="0,0,0,8"/>

            <TextBlock x:Name="TargetKey" Grid.Row="3" Grid.Column="0" Text="ONDE" Style="{StaticResource FieldKey}"/>
            <TextBlock x:Name="TargetText" Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldValue}"/>
        </Grid>

        <!-- CONTEUDO EXATO, quando existe -->
        <Border x:Name="PayloadBox"
                Margin="16,14,16,0"
                Background="{StaticResource SurfaceInputBrush}"
                BorderBrush="{StaticResource EdgeBrush}"
                BorderThickness="2,2,0,0"
                SnapsToDevicePixels="True">
            <Border BorderBrush="{StaticResource EdgeStrongBrush}" BorderThickness="0,0,2,2">
                <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="PayloadText"
                               Style="{StaticResource PixelMono}"
                               Margin="12"
                               TextWrapping="Wrap"
                               LineHeight="20"/>
                </ScrollViewer>
            </Border>
        </Border>

        <!-- CONTAGEM REGRESSIVA COMO BARRA
             "30S" em texto nao transmite urgencia nem progresso. -->
        <StackPanel Margin="16,14,16,0">
            <Border Background="{StaticResource SurfaceInputBrush}"
                    BorderBrush="{StaticResource EdgeBrush}"
                    BorderThickness="2"
                    SnapsToDevicePixels="True">
                <Grid Height="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="TimeLeftColumn" Width="1*"/>
                        <ColumnDefinition x:Name="TimeSpentColumn" Width="0*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Fill="{StaticResource WarningBrush}" SnapsToDevicePixels="True"/>
                </Grid>
            </Border>
            <TextBlock x:Name="CountdownText"
                       Style="{StaticResource PixelCaption}"
                       FontSize="{StaticResource FontSizeSmall}"
                       Foreground="{StaticResource WarningBrush}"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- ACOES
             NEGAR e a acao segura e leva o peso visual. PERMITIR fica contornado e
             discreto: antes ele era o unico botao preenchido, e em VERMELHO — a cor
             que o reflexo le como "pare" vestindo justamente a acao arriscada. -->
        <Grid Margin="16,16,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="DenyButton"
                    Grid.Column="0"
                    Content="NEGAR"
                    Height="46"
                    IsDefault="True"
                    IsCancel="True"
                    Background="{StaticResource AccentPrimaryPressedBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    ui:Pixel.LightEdge="{StaticResource AccentPrimaryBrush}"
                    ui:Pixel.DarkEdge="{StaticResource AccentPrimaryEdgeDarkBrush}"
                    ui:Pixel.HoverBackground="{StaticResource AccentPrimaryBrush}"
                    ui:Pixel.PressedBackground="{StaticResource AccentPrimaryEdgeDarkBrush}"
                    Click="OnDeny"/>

            <Button x:Name="ApproveButton"
                    Grid.Column="2"
                    Content="PERMITIR MESMO ASSIM"
                    Height="46"
                    Background="Transparent"
                    Foreground="{StaticResource ErrorBrush}"
                    ui:Pixel.LightEdge="{StaticResource ErrorBrush}"
                    ui:Pixel.DarkEdge="{StaticResource ErrorBrush}"
                    ui:Pixel.HoverBackground="{StaticResource DangerPressedBrush}"
                    ui:Pixel.PressedBackground="{StaticResource ErrorEdgeDarkBrush}"
                    Click="OnApprove"/>
        </Grid>
    </StackPanel>
</ui:PixelWindow>
