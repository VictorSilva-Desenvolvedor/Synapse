<ui:PixelWindow x:Class="Synapse.Tray.Onboarding.OnboardingWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:Synapse.Tray.UI"
                Title="CONFIGURACAO DO SYNAPSE"
                Subtitle="Conecte o cofre do Obsidian ao GitHub."
                Width="720"
                Height="800">

    <ui:PixelWindow.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource PixelHeadline}">
            <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource PixelCaption}">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource PixelCard}">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </ui:PixelWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="20,16,20,16">
            <StackPanel>

                <!-- 1. TOKEN -->
                <Border Style="{StaticResource Card}">
                    <Border Style="{StaticResource PixelCardInner}">
                        <StackPanel Margin="14">
                            <TextBlock Text="1. GITHUB PERSONAL ACCESS TOKEN" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="TokenBox" Grid.Column="0" Margin="0,0,8,0"/>
                                <Button x:Name="ValidateButton"
                                        Grid.Column="1"
                                        Content="VALIDAR"
                                        MinWidth="140"
                                        Click="OnValidateToken"/>
                            </Grid>
                            <TextBlock x:Name="TokenStatusText"
                                       Style="{StaticResource PixelCaption}"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="Insira um token do GitHub com escopo 'repo'."/>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- 2. COFRE -->
                <Border Style="{StaticResource Card}">
                    <Border Style="{StaticResource PixelCardInner}">
                        <StackPanel Margin="14">
                            <TextBlock Text="2. PASTA DO COFRE DO OBSIDIAN" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="VaultPathBox" Grid.Column="0" Margin="0,0,8,0"/>
                                <Button x:Name="BrowseButton"
                                        Grid.Column="1"
                                        Content="PROCURAR"
                                        MinWidth="140"
                                        Click="OnBrowseVault"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- 3. REPOSITORIO -->
                <Border Style="{StaticResource Card}">
                    <Border Style="{StaticResource PixelCardInner}">
                        <StackPanel Margin="14">
                            <TextBlock Text="3. REPOSITORIO PRIVADO NO GITHUB" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Usuario / Org:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="OwnerBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Nome do repositorio:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="RepoBox" Text="Synapse-Vault"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="AutoCreateCheck"
                                      Content="Criar repositorio privado se nao existir"
                                      IsChecked="True"
                                      Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- 4. GEMINI -->
                <Border Style="{StaticResource Card}">
                    <Border Style="{StaticResource PixelCardInner}">
                        <StackPanel Margin="14">
                            <TextBlock Text="4. GOOGLE GEMINI API KEY" Style="{StaticResource SectionTitle}"/>
                            <PasswordBox x:Name="GeminiKeyBox"/>
                            <TextBlock Style="{StaticResource PixelCaption}"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="Chave gratuita em https://aistudio.google.com/"/>
                        </StackPanel>
                    </Border>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- RODAPE -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource EdgeBrush}"
                BorderThickness="0,2,0,0"
                SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="20,12,20,12">
                <Button Content="CANCELAR"
                        MinWidth="140"
                        Margin="0,0,8,0"
                        Style="{StaticResource PixelButtonGhost}"
                        Click="OnCancel"/>
                <Button x:Name="SaveButton"
                        Content="SALVAR E INICIAR"
                        MinWidth="220"
                        Style="{StaticResource PixelButtonPrimary}"
                        Click="OnSave"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:PixelWindow>
