<ui:PixelWindow x:Class="Synapse.Tray.Review.FlashcardReviewWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:Synapse.Tray.UI"
                Title="REVISAO ATIVA"
                ShowTitleBar="False"
                Width="760"
                Height="500">

    <ui:PixelWindow.Resources>

        <!-- Fechar discreto: sem barra de titulo, o mouse precisa de uma saida.
             Fica apagado ate o hover para nao competir com a pergunta. -->
        <Style x:Key="FocusClose" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="0" SnapsToDevicePixels="True">
                            <TextBlock x:Name="Glyph"
                                       Text="X"
                                       Foreground="{StaticResource TextDisabledBrush}"
                                       FontFamily="{StaticResource FontBody}"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextOptions.TextRenderingMode="Aliased"
                                       TextOptions.TextFormattingMode="Display"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource ErrorBrush}"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <!-- Sem FocusVisualStyle, o foco de teclado precisa aparecer aqui. -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
                                <Setter TargetName="Bg" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Meta" TargetType="TextBlock" BasedOn="{StaticResource PixelTextBase}">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Botao de nota: mesma forma, so o preenchimento muda. Os quatro sao uma
             escada de luminancia — ferrugem, mel, musgo ESCURO, lima. O musgo escuro
             (AccentPrimaryPressed) e o conserto: com AccentPrimary, BOM e FACIL tinham
             luminancia identica e liam como um botao so. -->
        <Style x:Key="Grade" TargetType="Button" BasedOn="{StaticResource PixelButtonBase}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="4,2,4,2"/>
        </Style>

    </ui:PixelWindow.Resources>

    <!-- A janela inteira arrasta: sem barra de titulo, e o unico jeito de move-la
         com o mouse. Nao ha texto selecionavel aqui, entao nada conflita. -->
    <Grid MouseLeftButtonDown="OnDragWindow">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Unica cor de chrome da tela -->
        <Rectangle Grid.Row="0" Height="3" Fill="{StaticResource AccentPrimaryBrush}" SnapsToDevicePixels="True"/>

        <!-- Contexto minimo: progresso, origem, saida -->
        <Grid Grid.Row="1" Margin="18,12,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="CounterText" Grid.Column="0" Style="{StaticResource Meta}" Text="1 / 1"/>

            <TextBlock x:Name="SourceText"
                       Grid.Column="1"
                       Style="{StaticResource Meta}"
                       HorizontalAlignment="Right"
                       Margin="16,0,10,0"
                       TextTrimming="CharacterEllipsis"
                       Text="-"/>

            <Button Grid.Column="2" Style="{StaticResource FocusClose}" Click="OnClose" ToolTip="Fechar (Esc)"/>
        </Grid>

        <!-- O PALCO
             Duas faixas de altura fixa em vez de um bloco centralizado: a pergunta
             fica ancorada na mesma altura nos dois estados. Centralizar o conjunto
             fazia a pergunta subir 84px ao revelar — o texto que a pessoa esta lendo
             nao pode se mexer debaixo dela. -->
        <Grid Grid.Row="2" Margin="56,0,56,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="230"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="QuestionText"
                       Grid.Row="0"
                       Style="{StaticResource PixelHeadline}"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       LineHeight="34"
                       Text="Carregando pergunta..."/>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel VerticalAlignment="Top">
                    <Rectangle x:Name="Separator"
                               Height="2"
                               Width="320"
                               Margin="0,4,0,26"
                               Fill="{StaticResource EdgeBrush}"
                               Visibility="Collapsed"
                               SnapsToDevicePixels="True"/>

                    <TextBlock x:Name="AnswerText"
                               Foreground="{StaticResource SuccessBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               LineHeight="26"
                               MaxWidth="520"
                               Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Antes de revelar: so a instrucao. Depois: as quatro notas. -->
        <Grid Grid.Row="3" Margin="56,0,56,28">
            <TextBlock x:Name="RevealHint"
                       Style="{StaticResource Meta}"
                       HorizontalAlignment="Center"
                       Text="ESPACO PARA REVELAR"/>

            <UniformGrid x:Name="RatingPanel" Rows="1" Columns="4" Visibility="Collapsed">
                <Button Style="{StaticResource Grade}"
                        Margin="0,0,8,0"
                        Background="{StaticResource ErrorBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        ui:Pixel.LightEdge="{StaticResource ErrorEdgeLightBrush}"
                        ui:Pixel.DarkEdge="{StaticResource ErrorEdgeDarkBrush}"
                        ui:Pixel.HoverBackground="{StaticResource DangerHoverBrush}"
                        ui:Pixel.PressedBackground="{StaticResource DangerPressedBrush}"
                        Tag="0" Click="OnGrade">
                    <StackPanel>
                        <TextBlock Text="ERREI" TextAlignment="Center" FontSize="{StaticResource FontSizeBody}"/>
                        <TextBlock Text="0" TextAlignment="Center" FontSize="{StaticResource FontSizeSmall}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Grade}"
                        Margin="4,0,4,0"
                        Background="{StaticResource WarningBrush}"
                        Foreground="{StaticResource VoidBrush}"
                        ui:Pixel.LightEdge="{StaticResource WarningEdgeLightBrush}"
                        ui:Pixel.DarkEdge="{StaticResource WarningEdgeDarkBrush}"
                        ui:Pixel.HoverBackground="{StaticResource WarningHoverBrush}"
                        ui:Pixel.PressedBackground="{StaticResource WarningPressedBrush}"
                        Tag="3" Click="OnGrade">
                    <StackPanel>
                        <TextBlock Text="DIFICIL" TextAlignment="Center" FontSize="{StaticResource FontSizeBody}"/>
                        <TextBlock Text="3" TextAlignment="Center" FontSize="{StaticResource FontSizeSmall}"/>
                    </StackPanel>
                </Button>

                <!-- Musgo ESCURO, nao o musgo do acento: e o conserto do par de verdes -->
                <Button Style="{StaticResource Grade}"
                        Margin="4,0,4,0"
                        Background="{StaticResource AccentPrimaryPressedBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        ui:Pixel.LightEdge="{StaticResource AccentPrimaryBrush}"
                        ui:Pixel.DarkEdge="{StaticResource AccentPrimaryEdgeDarkBrush}"
                        ui:Pixel.HoverBackground="{StaticResource AccentPrimaryBrush}"
                        ui:Pixel.PressedBackground="{StaticResource AccentPrimaryEdgeDarkBrush}"
                        Tag="4" Click="OnGrade">
                    <StackPanel>
                        <TextBlock Text="BOM" TextAlignment="Center" FontSize="{StaticResource FontSizeBody}"/>
                        <TextBlock Text="4" TextAlignment="Center" FontSize="{StaticResource FontSizeSmall}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Grade}"
                        Margin="8,0,0,0"
                        Background="{StaticResource SuccessBrush}"
                        Foreground="{StaticResource VoidBrush}"
                        ui:Pixel.LightEdge="{StaticResource SuccessEdgeLightBrush}"
                        ui:Pixel.DarkEdge="{StaticResource SuccessEdgeDarkBrush}"
                        ui:Pixel.HoverBackground="{StaticResource SuccessHoverBrush}"
                        ui:Pixel.PressedBackground="{StaticResource SuccessPressedBrush}"
                        Tag="5" Click="OnGrade">
                    <StackPanel>
                        <TextBlock Text="FACIL" TextAlignment="Center" FontSize="{StaticResource FontSizeBody}"/>
                        <TextBlock Text="5" TextAlignment="Center" FontSize="{StaticResource FontSizeSmall}"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Grid>

    </Grid>
</ui:PixelWindow>
