<ui:PixelWindow x:Class="Synapse.Tray.UI.PixelPasswordPrompt"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:Synapse.Tray.UI"
                Title="CRIPTOGRAFIA"
                Width="520"
                SizeToContent="Height">

    <ui:PixelWindow.AccentBrush>
        <SolidColorBrush Color="{StaticResource AccentSecondaryColor}"/>
    </ui:PixelWindow.AccentBrush>

    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText"
                   Style="{StaticResource PixelCaption}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <PasswordBox x:Name="PasswordInput" MinHeight="36"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="CANCELAR"
                    MinWidth="130"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="OnCancel"/>
            <Button Content="CRIPTOGRAFAR"
                    MinWidth="180"
                    Style="{StaticResource PixelButtonPrimary}"
                    IsDefault="True"
                    Click="OnConfirm"/>
        </StackPanel>
    </StackPanel>
</ui:PixelWindow>
