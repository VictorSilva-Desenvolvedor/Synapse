<ui:PixelWindow x:Class="Synapse.Tray.Diagnostics.ConflictPickerWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:Synapse.Tray.UI"
                Title="CONFLITOS PRESERVADOS"
                Subtitle="Nenhum dado foi perdido (RNF-2)."
                Width="760"
                MinHeight="240"
                MaxHeight="620"
                SizeToContent="Height">

    <ui:PixelWindow.AccentBrush>
        <SolidColorBrush Color="{StaticResource WarningColor}"/>
    </ui:PixelWindow.AccentBrush>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cartoes em vez de tabela: a acao de resolver fica dentro do proprio item,
             em vez de exigir selecionar a linha e depois achar o botao certo. -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ConflictsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource EdgeLightBrush}"
                                BorderThickness="2,2,0,0"
                                Margin="0,0,0,6"
                                SnapsToDevicePixels="True">
                            <Border BorderBrush="{StaticResource EdgeBrush}" BorderThickness="0,0,2,2">
                                <DockPanel Margin="0">
                                    <Rectangle DockPanel.Dock="Left"
                                               Width="4"
                                               Fill="{StaticResource WarningBrush}"
                                               SnapsToDevicePixels="True"/>

                                    <!-- As duas acoes moram DENTRO do cartao. Antes,
                                         "ABRIR ARQUIVO" ficava no rodape e agia sobre o
                                         primeiro item — esta tela nao tem selecao, entao
                                         o botao operava num alvo que voce nao via. -->
                                    <Button DockPanel.Dock="Right"
                                            Content="RESOLVER"
                                            MinWidth="150"
                                            Margin="0,10,10,10"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource PixelButtonPrimary}"
                                            Click="OnResolve"/>

                                    <Button DockPanel.Dock="Right"
                                            Content="ABRIR"
                                            MinWidth="110"
                                            Margin="10"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource PixelButtonGhost}"
                                            Click="OnOpenFile"/>

                                    <StackPanel Margin="12,10,10,12" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Style="{StaticResource PixelCaption}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Margin="0,6,0,0"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Folder, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding ModifiedAt, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Size, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="1"
                Content="FECHAR"
                MinWidth="150"
                HorizontalAlignment="Right"
                Margin="0,14,0,0"
                IsCancel="True"
                Click="OnClose"/>
    </Grid>
</ui:PixelWindow>
