<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:ui="clr-namespace:Synapse.Tray.UI">

    <!-- ===================================================================
         PALETA VERDE-MUSGO
         Aconchego 16-bit: terra escura, madeira, trigo e musgo. Cores de
         ferramenta usada todo dia, nao de vitrine.
         Espelho de .claude/pixel-art/design-system.md e de PixelPalette.cs
         (GDI+, para o icone da bandeja). Cor nova exige entrada la primeiro.
         =================================================================== -->

    <Color x:Key="VoidColor">#FF1A1712</Color>
    <Color x:Key="SurfaceColor">#FF262019</Color>
    <Color x:Key="SurfaceAltColor">#FF342C22</Color>
    <Color x:Key="SurfaceInputColor">#FF14110D</Color>
    <Color x:Key="EdgeColor">#FF4A3E2E</Color>
    <Color x:Key="EdgeStrongColor">#FF6B5B43</Color>
    <Color x:Key="EdgeLightColor">#FFA08A63</Color>
    <Color x:Key="EdgeHighlightColor">#FFEFE0C2</Color>
    <Color x:Key="TextPrimaryColor">#FFEFE0C2</Color>
    <Color x:Key="TextSecondaryColor">#FFA89478</Color>
    <Color x:Key="TextDisabledColor">#FF6B5B43</Color>
    <Color x:Key="AccentPrimaryColor">#FF7FB069</Color>
    <Color x:Key="AccentPrimaryHoverColor">#FF9AC488</Color>
    <Color x:Key="AccentPrimaryPressedColor">#FF5E8A4C</Color>
    <Color x:Key="AccentSecondaryColor">#FFA585D6</Color>
    <Color x:Key="AccentSecondaryHoverColor">#FFBCA3E3</Color>
    <Color x:Key="AccentSecondaryPressedColor">#FF8464B5</Color>
    <Color x:Key="SuccessColor">#FFB8CF4C</Color>
    <Color x:Key="WarningColor">#FFE0A030</Color>
    <Color x:Key="ErrorColor">#FFC4553D</Color>

    <SolidColorBrush x:Key="VoidBrush" Color="{StaticResource VoidColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="SurfaceInputBrush" Color="{StaticResource SurfaceInputColor}"/>
    <SolidColorBrush x:Key="EdgeBrush" Color="{StaticResource EdgeColor}"/>
    <SolidColorBrush x:Key="EdgeStrongBrush" Color="{StaticResource EdgeStrongColor}"/>
    <SolidColorBrush x:Key="EdgeLightBrush" Color="{StaticResource EdgeLightColor}"/>
    <SolidColorBrush x:Key="EdgeHighlightBrush" Color="{StaticResource EdgeHighlightColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimaryColor}"/>
    <SolidColorBrush x:Key="AccentPrimaryHoverBrush" Color="{StaticResource AccentPrimaryHoverColor}"/>
    <SolidColorBrush x:Key="AccentPrimaryPressedBrush" Color="{StaticResource AccentPrimaryPressedColor}"/>
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondaryColor}"/>
    <SolidColorBrush x:Key="AccentSecondaryHoverBrush" Color="{StaticResource AccentSecondaryHoverColor}"/>
    <SolidColorBrush x:Key="AccentSecondaryPressedBrush" Color="{StaticResource AccentSecondaryPressedColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>

    <!-- Arestas e estados derivados de cada cor de preenchimento.
         Todo botao colorido do app monta seu bevel a partir daqui — nenhum XAML de
         tela declara hex proprio, senao trocar de identidade visual deixaria cores
         orfas espalhadas pelas janelas. -->

    <!-- Acao primaria (musgo) -->
    <SolidColorBrush x:Key="AccentPrimaryEdgeLightBrush" Color="#FFB6DCA4"/>
    <SolidColorBrush x:Key="AccentPrimaryEdgeDarkBrush" Color="#FF4C7340"/>

    <!-- Erro / acao destrutiva (ferrugem) -->
    <SolidColorBrush x:Key="ErrorEdgeLightBrush" Color="#FFE09080"/>
    <SolidColorBrush x:Key="ErrorEdgeDarkBrush" Color="#FF7A2F1E"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#FFD4674F"/>
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#FFA03F2B"/>

    <!-- Atencao (mel) -->
    <SolidColorBrush x:Key="WarningEdgeLightBrush" Color="#FFF2C87A"/>
    <SolidColorBrush x:Key="WarningEdgeDarkBrush" Color="#FF8F6318"/>
    <SolidColorBrush x:Key="WarningHoverBrush" Color="#FFEDB55C"/>
    <SolidColorBrush x:Key="WarningPressedBrush" Color="#FFB87F20"/>

    <!-- Sucesso (lima) -->
    <SolidColorBrush x:Key="SuccessEdgeLightBrush" Color="#FFD9E58F"/>
    <SolidColorBrush x:Key="SuccessEdgeDarkBrush" Color="#FF77862B"/>
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="#FFC8DB6B"/>
    <SolidColorBrush x:Key="SuccessPressedBrush" Color="#FF97AC38"/>

    <!-- ===================================================================
         TIPOGRAFIA PIXEL
         Fontes embutidas como Resource; o nome apos # e a familia interna
         do TTF, nao o nome do arquivo.
         =================================================================== -->

    <FontFamily x:Key="FontDisplay">pack://application:,,,/Synapse.Tray;component/Resources/Fonts/#Press Start 2P</FontFamily>
    <FontFamily x:Key="FontBody">pack://application:,,,/Synapse.Tray;component/Resources/Fonts/#Silkscreen</FontFamily>
    <FontFamily x:Key="FontMono">Consolas</FontFamily>

    <!-- Tamanhos em DIP. Fonte pixel nao interpola: so multiplos da grade
         nativa de 8px renderizam nitidos. Hierarquia vem de cor e familia,
         nao de escala continua. -->
    <sys:Double x:Key="FontSizeDisplay">24</sys:Double>
    <sys:Double x:Key="FontSizeHeadline">16</sys:Double>
    <sys:Double x:Key="FontSizeBody">16</sys:Double>
    <sys:Double x:Key="FontSizeCaption">16</sys:Double>
    <!-- Passo pequeno para contexto denso: linhas de tabela, fichas, rotulos de campo.
         Existe declarado porque, sem ele, cada tela inventava o proprio 12/13/14. -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeMono">13</sys:Double>

    <!-- ===================================================================
         TEXTO
         =================================================================== -->

    <Style x:Key="PixelTextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="PixelDisplay" TargetType="TextBlock" BasedOn="{StaticResource PixelTextBase}">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}"/>
    </Style>

    <Style x:Key="PixelHeadline" TargetType="TextBlock" BasedOn="{StaticResource PixelTextBase}">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeadline}"/>
    </Style>

    <Style x:Key="PixelCaption" TargetType="TextBlock" BasedOn="{StaticResource PixelTextBase}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <Style x:Key="PixelMono" TargetType="TextBlock" BasedOn="{StaticResource PixelTextBase}">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeMono}"/>
    </Style>

    <Style TargetType="TextBlock" BasedOn="{StaticResource PixelTextBase}"/>

    <!-- ===================================================================
         BEVEL 8-BIT
         Duas Borders aninhadas: luz em cima/esquerda, sombra embaixo/direita.
         Uma unica Border nao serve - ela so aceita um BorderBrush.
         =================================================================== -->

    <Style x:Key="PixelCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource EdgeLightBrush}"/>
        <Setter Property="BorderThickness" Value="2,2,0,0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style x:Key="PixelCardInner" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,2,2"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <!-- ===================================================================
         BOTAO ARCADE
         O relevo inverte quando pressionado e o conteudo desloca 2px,
         reproduzindo o clique mecanico do SynapseButton original.
         =================================================================== -->

    <ControlTemplate x:Key="PixelButtonTemplate" TargetType="Button">
        <Border x:Name="Outer"
                Background="{TemplateBinding Background}"
                BorderBrush="{StaticResource VoidBrush}"
                BorderThickness="1"
                CornerRadius="0"
                SnapsToDevicePixels="True">
            <Border x:Name="EdgeLight"
                    BorderBrush="{Binding Path=(ui:Pixel.LightEdge), RelativeSource={RelativeSource TemplatedParent}}"
                    BorderThickness="2,2,0,0"
                    CornerRadius="0"
                    SnapsToDevicePixels="True">
                <Border x:Name="EdgeDark"
                        BorderBrush="{Binding Path=(ui:Pixel.DarkEdge), RelativeSource={RelativeSource TemplatedParent}}"
                        BorderThickness="0,0,2,2"
                        CornerRadius="0"
                        SnapsToDevicePixels="True">
                    <ContentPresenter x:Name="PixelContent"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"
                                      TextOptions.TextRenderingMode="Aliased"
                                      TextOptions.TextFormattingMode="Display"/>
                </Border>
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Outer" Property="Background"
                        Value="{Binding Path=(ui:Pixel.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <!-- Luz e sombra trocam de lado: o botao afunda -->
                <Setter TargetName="Outer" Property="Background"
                        Value="{Binding Path=(ui:Pixel.PressedBackground), RelativeSource={RelativeSource TemplatedParent}}"/>
                <Setter TargetName="EdgeLight" Property="BorderBrush"
                        Value="{Binding Path=(ui:Pixel.DarkEdge), RelativeSource={RelativeSource TemplatedParent}}"/>
                <Setter TargetName="EdgeDark" Property="BorderBrush"
                        Value="{Binding Path=(ui:Pixel.LightEdge), RelativeSource={RelativeSource TemplatedParent}}"/>
                <Setter TargetName="PixelContent" Property="Margin" Value="14,6,10,2"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Outer" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Outer" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter TargetName="EdgeLight" Property="BorderBrush" Value="{StaticResource EdgeBrush}"/>
                <Setter TargetName="EdgeDark" Property="BorderBrush" Value="{StaticResource VoidBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="PixelButtonBase" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource PixelButtonTemplate}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="12,4,12,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="PixelButtonSecondary" TargetType="Button" BasedOn="{StaticResource PixelButtonBase}">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="ui:Pixel.LightEdge" Value="{StaticResource EdgeLightBrush}"/>
        <Setter Property="ui:Pixel.DarkEdge" Value="{StaticResource VoidBrush}"/>
        <Setter Property="ui:Pixel.HoverBackground" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="ui:Pixel.PressedBackground" Value="{StaticResource SurfaceBrush}"/>
    </Style>

    <Style x:Key="PixelButtonPrimary" TargetType="Button" BasedOn="{StaticResource PixelButtonBase}">
        <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource VoidBrush}"/>
        <Setter Property="ui:Pixel.LightEdge" Value="{StaticResource AccentPrimaryEdgeLightBrush}"/>
        <Setter Property="ui:Pixel.DarkEdge" Value="{StaticResource AccentPrimaryEdgeDarkBrush}"/>
        <Setter Property="ui:Pixel.HoverBackground" Value="{StaticResource AccentPrimaryHoverBrush}"/>
        <Setter Property="ui:Pixel.PressedBackground" Value="{StaticResource AccentPrimaryPressedBrush}"/>
    </Style>

    <Style x:Key="PixelButtonDanger" TargetType="Button" BasedOn="{StaticResource PixelButtonBase}">
        <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="ui:Pixel.LightEdge" Value="{StaticResource ErrorEdgeLightBrush}"/>
        <Setter Property="ui:Pixel.DarkEdge" Value="{StaticResource ErrorEdgeDarkBrush}"/>
        <Setter Property="ui:Pixel.HoverBackground" Value="{StaticResource DangerHoverBrush}"/>
        <Setter Property="ui:Pixel.PressedBackground" Value="{StaticResource DangerPressedBrush}"/>
    </Style>

    <Style x:Key="PixelButtonGhost" TargetType="Button" BasedOn="{StaticResource PixelButtonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="ui:Pixel.LightEdge" Value="{StaticResource EdgeBrush}"/>
        <Setter Property="ui:Pixel.DarkEdge" Value="{StaticResource EdgeBrush}"/>
        <Setter Property="ui:Pixel.HoverBackground" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="ui:Pixel.PressedBackground" Value="{StaticResource SurfaceBrush}"/>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource PixelButtonSecondary}"/>

    <!-- ===================================================================
         ENTRADA DE TEXTO - moldura afundada (luz e sombra invertidas
         em relacao ao botao, para o campo parecer rebaixado)
         =================================================================== -->

    <ControlTemplate x:Key="PixelTextBoxTemplate" TargetType="TextBoxBase">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{StaticResource VoidBrush}"
                BorderThickness="1"
                CornerRadius="0"
                SnapsToDevicePixels="True">
            <Border BorderBrush="{StaticResource EdgeBrush}"
                    BorderThickness="2,2,0,0"
                    CornerRadius="0"
                    SnapsToDevicePixels="True">
                <Border BorderBrush="{StaticResource EdgeStrongBrush}"
                        BorderThickness="0,0,2,2"
                        CornerRadius="0"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"/>

                        <!-- Marca d'agua: some assim que o campo tem qualquer texto. -->
                        <TextBlock x:Name="Watermark"
                                   Text="{Binding Path=(ui:Pixel.Watermark), RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{StaticResource TextDisabledBrush}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Margin="{TemplateBinding Padding}"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed"
                                   TextOptions.TextRenderingMode="Aliased"
                                   TextOptions.TextFormattingMode="Display"/>
                    </Grid>
                </Border>
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=(ui:Pixel.HasText), RelativeSource={RelativeSource Self}}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
            </MultiDataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="PixelTextBox" TargetType="TextBox">
        <Setter Property="Template" Value="{StaticResource PixelTextBoxTemplate}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceInputBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentPrimaryBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Padding" Value="8,6,8,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource PixelTextBox}"/>

    <!-- PasswordBox NAO deriva de TextBoxBase (deriva direto de Control), entao nao
         aceita o ControlTemplate do TextBox: o WPF valida o TargetType em tempo de
         aplicacao e lanca ArgumentException. A arvore visual e a mesma, mas o template
         precisa ser declarado separadamente. -->
    <ControlTemplate x:Key="PixelPasswordBoxTemplate" TargetType="PasswordBox">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{StaticResource VoidBrush}"
                BorderThickness="1"
                CornerRadius="0"
                SnapsToDevicePixels="True">
            <Border BorderBrush="{StaticResource EdgeBrush}"
                    BorderThickness="2,2,0,0"
                    CornerRadius="0"
                    SnapsToDevicePixels="True">
                <Border BorderBrush="{StaticResource EdgeStrongBrush}"
                        BorderThickness="0,0,2,2"
                        CornerRadius="0"
                        SnapsToDevicePixels="True">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Margin="{TemplateBinding Padding}"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Hidden"/>
                </Border>
            </Border>
        </Border>
    </ControlTemplate>

    <Style TargetType="PasswordBox">
        <Setter Property="Template" Value="{StaticResource PixelPasswordBoxTemplate}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceInputBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Padding" Value="8,6,8,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <!-- ===================================================================
         LISTA / TABELA 8-BIT
         Cabecalho com relevo, linhas alternadas por cor de fundo, selecao
         em ciano solido. Sem gridlines curvas nem gradiente.
         =================================================================== -->

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="10,6,10,6"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource EdgeLightBrush}"
                            BorderThickness="0,2,0,0"
                            CornerRadius="0"
                            SnapsToDevicePixels="True">
                        <Border BorderBrush="{StaticResource VoidBrush}"
                                BorderThickness="0,0,2,2"
                                CornerRadius="0">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              TextOptions.TextRenderingMode="Aliased"
                                              TextOptions.TextFormattingMode="Display"/>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PixelListViewItem" TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Padding" Value="0,6,0,6"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bg"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="0"
                            SnapsToDevicePixels="True">
                        <GridViewRowPresenter TextOptions.TextRenderingMode="Aliased"
                                              TextOptions.TextFormattingMode="Display"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource VoidBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListView">
        <Setter Property="Background" Value="{StaticResource SurfaceInputBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource PixelListViewItem}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- ===================================================================
         BARRA DE ROLAGEM 8-BIT - blocos solidos, sem cantos nem gradiente
         =================================================================== -->

    <Style x:Key="PixelScrollBarThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource EdgeStrongBrush}"
                            BorderBrush="{StaticResource EdgeLightBrush}"
                            BorderThickness="2,2,0,0"
                            CornerRadius="0"
                            SnapsToDevicePixels="True">
                        <Border BorderBrush="{StaticResource VoidBrush}"
                                BorderThickness="0,0,2,2"
                                CornerRadius="0"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Background" Value="{StaticResource VoidBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource PixelScrollBarThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <!-- Width precisa voltar a Auto: o Setter de Width=16 do Style
                                 continua valendo na horizontal e deixaria a barra como um
                                 quadrado de 16x16 em vez de ocupar a largura do painel. -->
                            <Setter Property="Width" Value="Auto"/>
                            <Setter Property="Height" Value="16"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <!-- ===================================================================
         MENU DA BANDEJA 8-BIT
         Substitui SynapseMenuRenderer (ToolStripRenderer do WinForms).
         Item ativo pinta ciano solido com texto no tom do fundo.
         =================================================================== -->

    <Style TargetType="Separator">
        <Setter Property="Height" Value="2"/>
        <Setter Property="Margin" Value="6,4,6,4"/>
        <Setter Property="Background" Value="{StaticResource EdgeBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="2" Fill="{TemplateBinding Background}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bg"
                            Background="Transparent"
                            Padding="12,8,16,8"
                            CornerRadius="0"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Marca de item ligado: bloco solido, sem check vetorial -->
                            <Rectangle x:Name="CheckMark"
                                       Grid.Column="0"
                                       Width="8" Height="8"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Fill="{StaticResource SuccessBrush}"
                                       Visibility="Collapsed"
                                       SnapsToDevicePixels="True"/>
                            <!-- TextBlock explicito, nao ContentPresenter: o
                                 ContentPresenter gera um TextBlock que pega o estilo
                                 IMPLICITO de TextBlock, e setter de estilo vence
                                 heranca de propriedade — o cabecalho perdia a fonte
                                 Press Start 2P e a cor. TemplateBinding grava valor
                                 LOCAL, que vence o estilo implicito. -->
                            <TextBlock Grid.Column="1"
                                       Text="{TemplateBinding Header}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center"
                                       TextOptions.TextRenderingMode="Aliased"
                                       TextOptions.TextFormattingMode="Display"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource VoidBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                            <Setter TargetName="Bg" Property="Background" Value="Transparent"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================
         LADRILHOS DO MENU DA BANDEJA
         Alvos grandes para as quatro acoes diarias. Mesmo bevel dos botoes,
         mas quadrados e com o conteudo empilhado (icone sobre rotulo).
         =================================================================== -->

    <Style x:Key="TrayTile" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource PixelButtonTemplate}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="ui:Pixel.LightEdge" Value="{StaticResource EdgeLightBrush}"/>
        <Setter Property="ui:Pixel.DarkEdge" Value="{StaticResource VoidBrush}"/>
        <Setter Property="ui:Pixel.HoverBackground" Value="{StaticResource EdgeBrush}"/>
        <Setter Property="ui:Pixel.PressedBackground" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Padding" Value="10,13,10,12"/>
        <Setter Property="MinHeight" Value="78"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <!-- A acao mais frequente carrega o musgo escuro: destaque sem gritar. -->
    <Style x:Key="TrayTilePrimary" TargetType="Button" BasedOn="{StaticResource TrayTile}">
        <Setter Property="Background" Value="{StaticResource AccentPrimaryPressedBrush}"/>
        <Setter Property="ui:Pixel.LightEdge" Value="{StaticResource AccentPrimaryBrush}"/>
        <Setter Property="ui:Pixel.DarkEdge" Value="{StaticResource AccentPrimaryEdgeDarkBrush}"/>
        <Setter Property="ui:Pixel.HoverBackground" Value="{StaticResource AccentPrimaryBrush}"/>
        <Setter Property="ui:Pixel.PressedBackground" Value="{StaticResource AccentPrimaryEdgeDarkBrush}"/>
    </Style>

    <!-- Cabecalho de status do menu: nao clicavel, em Press Start 2P sobre o acento.
         Nao usa IsEnabled=False: o trigger de desabilitado do template pintaria o texto
         de TextDisabled e mataria o acento. IsHitTestVisible+Focusable dao o mesmo
         "nao clicavel" sem disparar o trigger. -->
    <Style x:Key="PixelMenuHeader" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource EdgeLightBrush}"
                            BorderThickness="2,2,0,0"
                            CornerRadius="0"
                            SnapsToDevicePixels="True">
                        <Border BorderBrush="{StaticResource VoidBrush}"
                                BorderThickness="0,0,2,2"
                                CornerRadius="0">
                            <StackPanel IsItemsHost="True" Margin="4"/>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================
         ABAS 8-BIT - aba ativa sobe, ganha acento no topo e fundo de card
         =================================================================== -->

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Tab"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource EdgeBrush}"
                            BorderThickness="2,2,2,0"
                            Margin="0,0,4,0"
                            CornerRadius="0"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Rectangle x:Name="Accent"
                                       Grid.Row="0"
                                       Fill="Transparent"
                                       SnapsToDevicePixels="True"/>
                            <ContentPresenter Grid.Row="1"
                                              ContentSource="Header"
                                              Margin="18,8,18,8"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextOptions.TextRenderingMode="Aliased"
                                              TextOptions.TextFormattingMode="Display"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Tab" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                            <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource EdgeLightBrush}"/>
                            <Setter TargetName="Accent" Property="Fill" Value="{StaticResource AccentPrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TabPanel Grid.Row="0" Panel.ZIndex="1" IsItemsHost="True" Margin="0"/>
                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource EdgeLightBrush}"
                                BorderThickness="2"
                                CornerRadius="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================
         CHECKBOX 8-BIT - caixa de 20px com relevo afundado e marca solida
         =================================================================== -->

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border Width="20" Height="20"
                                VerticalAlignment="Center"
                                Background="{StaticResource SurfaceInputBrush}"
                                BorderBrush="{StaticResource EdgeBrush}"
                                BorderThickness="2,2,0,0"
                                CornerRadius="0"
                                SnapsToDevicePixels="True">
                            <Border BorderBrush="{StaticResource EdgeStrongBrush}"
                                    BorderThickness="0,0,2,2"
                                    CornerRadius="0">
                                <Rectangle x:Name="Mark"
                                           Margin="4"
                                           Fill="{StaticResource AccentPrimaryBrush}"
                                           Visibility="Collapsed"
                                           SnapsToDevicePixels="True"/>
                            </Border>
                        </Border>
                        <ContentPresenter Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          TextOptions.TextRenderingMode="Aliased"
                                          TextOptions.TextFormattingMode="Display"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                            <Setter TargetName="Mark" Property="Fill" Value="{StaticResource TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================
         COMBOBOX 8-BIT
         O template padrao do Windows traz cantos arredondados e gradiente,
         que sao reprovacao automatica na rubrica. Reescrito por inteiro.
         =================================================================== -->

    <Style x:Key="PixelComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="8,6,8,6"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bg"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="0"
                            SnapsToDevicePixels="True">
                        <ContentPresenter TextOptions.TextRenderingMode="Aliased"
                                          TextOptions.TextFormattingMode="Display"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource VoidBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource SurfaceInputBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="8,4,8,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource PixelComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="PART_Toggle"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <!-- Moldura afundada, igual a do TextBox -->
                                    <Border Background="{StaticResource SurfaceInputBrush}"
                                            BorderBrush="{StaticResource VoidBrush}"
                                            BorderThickness="1"
                                            CornerRadius="0"
                                            SnapsToDevicePixels="True">
                                        <Border BorderBrush="{StaticResource EdgeBrush}"
                                                BorderThickness="2,2,0,0"
                                                CornerRadius="0">
                                            <Border BorderBrush="{StaticResource EdgeStrongBrush}"
                                                    BorderThickness="0,0,2,2"
                                                    CornerRadius="0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="24"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Seta desenhada como bloco solido, sem curva -->
                                                    <Path Grid.Column="1"
                                                          Data="M 0,0 L 8,0 L 4,6 Z"
                                                          Fill="{StaticResource AccentPrimaryBrush}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          RenderOptions.EdgeMode="Aliased"/>
                                                </Grid>
                                            </Border>
                                        </Border>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          TextOptions.TextRenderingMode="Aliased"
                                          TextOptions.TextFormattingMode="Display"/>

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="False"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               PopupAnimation="None">
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource EdgeLightBrush}"
                                    BorderThickness="2"
                                    CornerRadius="0"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    SnapsToDevicePixels="True">
                                <ItemsPresenter SnapsToDevicePixels="True"/>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
