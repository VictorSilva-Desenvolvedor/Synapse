<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Synapse.Tray.UI">

    <ui:EmptyToCollapsedConverter x:Key="EmptyToCollapsedConverter"/>

    <!-- Botao fechar da barra de topo: quadrado, sem bevel, vira vermelho no hover -->
    <Style x:Key="PixelWindowCloseButton" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="0" SnapsToDevicePixels="True">
                        <TextBlock Text="X"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   TextOptions.TextRenderingMode="Aliased"
                                   TextOptions.TextFormattingMode="Display"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource ErrorBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================
         CHROME DA JANELA
         Moldura 8-bit (luz cima/esquerda, sombra baixo/direita) + barra de
         topo de 64px com faixa de acento de 6px, titulo, subtitulo e fechar.
         Toda tela herda isso; nenhuma redesenha o proprio cabecalho.
         =================================================================== -->
    <Style x:Key="PixelWindowStyle" TargetType="ui:PixelWindow">
        <Setter Property="Background" Value="{StaticResource VoidBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="AccentBrush" Value="{StaticResource AccentPrimaryBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor"/>
        <Setter Property="RenderOptions.EdgeMode" Value="Aliased"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:PixelWindow">
                    <!-- Moldura externa: 2px de luz em cima/esquerda... -->
                    <Border Background="{StaticResource VoidBrush}"
                            BorderBrush="{StaticResource EdgeLightBrush}"
                            BorderThickness="2,2,0,0"
                            CornerRadius="0"
                            SnapsToDevicePixels="True">
                        <!-- ...e 2px de sombra embaixo/direita -->
                        <Border BorderBrush="{StaticResource VoidBrush}"
                                BorderThickness="0,0,2,2"
                                CornerRadius="0"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- Auto, nao 64 fixo: quando ShowTitleBar e False a
                                         Border colapsa e a linha vai a zero sozinha. -->
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- BARRA DE TOPO -->
                                <Border x:Name="PART_TitleBar"
                                        Grid.Row="0"
                                        MinHeight="64"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource EdgeBrush}"
                                        BorderThickness="0,0,0,2"
                                        CornerRadius="0"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Faixa de acento de 6px -->
                                        <Rectangle Grid.Column="0"
                                                   Fill="{TemplateBinding AccentBrush}"
                                                   SnapsToDevicePixels="True"/>

                                        <StackPanel Grid.Column="1"
                                                    Margin="12,0,8,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{TemplateBinding Title}"
                                                       Style="{StaticResource PixelHeadline}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{TemplateBinding Subtitle}"
                                                       Style="{StaticResource PixelCaption}"
                                                       Margin="0,6,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding Subtitle,
                                                           RelativeSource={RelativeSource TemplatedParent},
                                                           Converter={StaticResource EmptyToCollapsedConverter}}"/>
                                        </StackPanel>

                                        <Button x:Name="PART_Close"
                                                Grid.Column="2"
                                                Style="{StaticResource PixelWindowCloseButton}"
                                                VerticalAlignment="Top"
                                                Margin="0,4,4,0"/>
                                    </Grid>
                                </Border>

                                <!-- CORPO -->
                                <ContentPresenter Grid.Row="1"
                                                  SnapsToDevicePixels="True"/>
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowTitleBar" Value="False">
                            <Setter TargetName="PART_TitleBar" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
